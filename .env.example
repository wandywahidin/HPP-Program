# Salin file ini ke .env lalu isi nilainya.

# SQLite untuk development. Untuk produksi ganti ke PostgreSQL,
# mis: postgresql://user:pass@host:5432/hpp?schema=public
DATABASE_URL="file:./dev.db"

# Wajib: secret untuk Auth.js — generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-secret-acak"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mode dev: set "true" untuk mengaktifkan tombol "Login Dev (tanpa Google)"
# agar aplikasi bisa dicoba sebelum kredensial Google siap. JANGAN aktifkan di produksi.
AUTH_DEV_LOGIN="true"
